{
  "apphosting": {
    "backendId": "automanqanebi",
    "rootDir": "/",
    "ignore": ["node_modules", ".git", ".next", "AUTOGE-CLEAN", "*.zip", "firebase-debug.log"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Automanqanebi",
        "supportEmail": "info@automanqanebi.ge",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://automanqanebi.ge",
          "https://automanqanebi1.web.app",
          "https://automanqanebi1.firebaseapp.com"
        ]
      }
    },
    "authorizedDomains": [
      "localhost",
      "automanqanebi.ge",
      "automanqanebi1.web.app",
      "automanqanebi1.firebaseapp.com"
    ]
  }
}
