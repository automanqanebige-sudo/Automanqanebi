# Firebase web app config (Firebase Console → Project settings → Your apps → Config)
# Copy to .env.local for development.
# Production: use .env.production / apphosting.yaml.
# IMPORTANT: on https://automanqanebi.ge set AUTH_DOMAIN=automanqanebi.ge (same-origin)
# so Google login works on Chrome/Safari/mobile. Locally keep *.firebaseapp.com.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional (Firebase Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# FCM Web Push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Payment provider: stub (demo checkout at /payments/checkout) | bog (wire later)
NEXT_PUBLIC_PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=

# Cron / scheduled jobs (expire listings, VIP SMS)
# POST https://automanqanebi.ge/api/cron/expire-listings
# POST https://automanqanebi.ge/api/cron/vip-sms-reminders  body: {"scan":true}
CRON_SECRET=

# SMS gateway (Twilio: SMS_PROVIDER=twilio, SMS_API_KEY=AccountSID, SMS_API_SECRET=AuthToken, SMS_FROM=+1...)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# Legacy FCM server key for chat web push (optional)
FCM_SERVER_KEY=

# Production: hide demo sample cars/services (set in apphosting.yaml for production)
NEXT_PUBLIC_USE_SAMPLE_DATA=false

# Comma-separated admin emails for /admin panel
NEXT_PUBLIC_ADMIN_EMAILS=rkakalashvili19@gmail.com

# Firebase Console → Authentication → Sign-in method:
# - Enable Email/Password
# - Enable Google (add authorized domains: localhost, automanqanebi.ge, *.web.app)
#
# Firebase Console → Firestore → deploy rules:
#   npx firebase deploy --only firestore:rules,storage
#
# For admin delete in Firestore rules, add document admins/{your-firebase-uid}
