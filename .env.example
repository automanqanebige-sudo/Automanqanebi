# Firebase web app config (Firebase Console → Project settings → Your apps → Config)
# Copy to .env.local for development. In production these live in apphosting.yaml.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional (Firebase Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Production: hide demo sample cars/services (set in apphosting.yaml for production)
NEXT_PUBLIC_USE_SAMPLE_DATA=false

# Comma-separated admin emails for /admin panel (e.g. info@automanqanebi.ge)
NEXT_PUBLIC_ADMIN_EMAILS=info@automanqanebi.ge

# Firebase Console → Authentication → Sign-in method:
# - Enable Email/Password
# - Enable Google (add authorized domains: localhost, automanqanebi.ge, *.web.app)
#
# Firebase Console → Firestore → deploy rules:
#   npx firebase deploy --only firestore:rules,storage
#
# For admin delete in Firestore rules, add document admins/{your-firebase-uid}
